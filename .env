# 本地开发端口
PORT=3000

# 如果需要使用生产环境的API，请把下面一行注释掉，或者在.env.development.local中覆盖
VITE_API=https://share.maayuan.fun:16666/api
# Siming generator service base URL (MaaYuan-SiMing)
VITE_SIMING_BASE_URL=https://share.maayuan.top/simingapi
VITE_SITE_PRIMARY=https://share.maayuan.fun:16666
VITE_SITE_BACKUP=https://share.maayuan.top

# 是否启用“注册码注册”模式（true/false），默认关闭
VITE_USE_REG_CODE=false
VITE_ENABLE_ANNOUNCEMENT=false
